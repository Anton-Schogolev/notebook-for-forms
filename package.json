{
  "name": "notebook-for-forms",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/jest": "^27.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "antd": "^6.7.2",
    "immer": "^11.2.10",
    "localforage": "^1.10.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5",
    "uuid": "^11.1.0",
    "zustand": "^5.1.0"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc --noEmit && eslint src --ext .js,.jsx,.ts,.tsx && vite build",
    "test": "react-scripts test"
  },
  "jest": {
    "moduleNameMapper": {
      "^@ant-design/colors/es/(.*)$": "@ant-design/colors/lib/$1",
      "^@rc-component/(pagination|picker)/(locale|generate)/(.*)$": "@rc-component/$1/lib/$2/$3"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "overrides": [
      {
        "files": ["vite.config.mjs"],
        "parser": "espree",
        "parserOptions": { "ecmaVersion": "latest", "sourceType": "module" },
        "env": { "node": true }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@vitejs/plugin-legacy": "^7.2.1",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "browserslist": "^4.29.6",
    "browserslist-to-esbuild": "^2.1.1",
    "eslint": "8.35.0",
    "terser": "^5.16.5",
    "vite": "^7.3.8"
  }
}
