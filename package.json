{
  "name": "notebook-for-forms",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@ant-design/icons": "^5.0.1",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@types/uuid": "^9.0.1",
    "antd": "^5.2.3",
    "localforage": "^1.10.0",
    "mui-button": "^1.0.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5",
    "uuid": "^9.0.0",
    "web-vitals": "^2.1.4",
    "zustand": "^4.3.6"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc --noEmit && eslint src --ext .js,.jsx,.ts,.tsx && vite build",
    "test": "react-scripts test"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "overrides": [
      {
        "files": ["vite.config.mjs"],
        "parser": "espree",
        "parserOptions": { "ecmaVersion": "latest", "sourceType": "module" },
        "env": { "node": true }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@vitejs/plugin-legacy": "^7.2.1",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "browserslist": "^4.29.6",
    "browserslist-to-esbuild": "^2.1.1",
    "eslint": "8.35.0",
    "terser": "^5.16.5",
    "vite": "^7.3.8"
  }
}
